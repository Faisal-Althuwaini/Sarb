# Root .env, read automatically by `docker compose` for ${VAR} substitution
# in docker-compose.yml. Separate from each service's own gitignored .env
# (used by DotenvEnvironmentPostProcessor for local `mvnw spring-boot:run`) -
# this one only matters when running the stack via `docker compose up`.
JWT_SECRET=change-me-to-a-long-random-base64-string
ANTHROPIC_API_KEY=sk-ant-...
